# Selgo Marketplace Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_USER=postgres
DB_PASSWORD=12345
DB_HOST=postgres
DB_PORT=5432

# Individual database names
DB_AUTH=selgo_auth
DB_PROPERTY=selgo_property
DB_CAR=selgo_car
DB_MOTORCYCLE=selgo_motorcycle
DB_BOAT=selgo_boat
DB_JOB=selgo_job
DB_CHAT=selgo_chat
DB_SQUARE=selgo_square
DB_TRAVEL=selgo_travel
DB_ELECTRONICS=selgo_electronics
DB_COMMERCIAL=selgo_commercial

# =============================================================================
# SECURITY CONFIGURATION (CHANGE IN PRODUCTION!)
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# SERVICE URLS (Internal Docker Network)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service:8001
PROPERTY_SERVICE_URL=http://property-service:8004
CAR_SERVICE_URL=http://car-service:8005
MOTORCYCLE_SERVICE_URL=http://motorcycle-service:8003
BOAT_SERVICE_URL=http://boat-service:8000
JOB_SERVICE_URL=http://job-service:8002
CHAT_SERVICE_URL=http://chat-service:8007

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_PROPERTY_SERVICE_URL=http://localhost:8004
NEXT_PUBLIC_CAR_SERVICE_URL=http://localhost:8005
NEXT_PUBLIC_MOTORCYCLE_SERVICE_URL=http://localhost:8003
NEXT_PUBLIC_BOAT_SERVICE_URL=http://localhost:8000
NEXT_PUBLIC_JOB_SERVICE_URL=http://localhost:8002
NEXT_PUBLIC_CHAT_SERVICE_URL=http://localhost:8007

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
ENVIRONMENT=development
API_HOST=0.0.0.0
DEBUG=true

# Service-specific ports
AUTH_SERVICE_PORT=8001
PROPERTY_SERVICE_PORT=8004
CAR_SERVICE_PORT=8005
MOTORCYCLE_SERVICE_PORT=8003
BOAT_SERVICE_PORT=8000
JOB_SERVICE_PORT=8002
CHAT_SERVICE_PORT=8007

# =============================================================================
# PGADMIN CONFIGURATION
# =============================================================================
PGADMIN_DEFAULT_EMAIL=admin@selgo.com
PGADMIN_DEFAULT_PASSWORD=admin

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,pdf,doc,docx
UPLOAD_PATH=/app/uploads

# =============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# =============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_TLS=true

# =============================================================================
# EXTERNAL API KEYS (Optional - for integrations)
# =============================================================================
# GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# STRIPE_SECRET_KEY=your-stripe-secret-key
# STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60  # seconds

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
CACHE_TTL=300  # 5 minutes
CACHE_MAX_SIZE=1000

# =============================================================================
# WEBSOCKET CONFIGURATION (for Chat Service)
# =============================================================================
WS_MAX_CONNECTIONS=1000
WS_HEARTBEAT_INTERVAL=30

# =============================================================================
# PRODUCTION OVERRIDES (Uncomment for production)
# =============================================================================
# NODE_ENV=production
# DEBUG=false
# LOG_LEVEL=WARNING
# ENVIRONMENT=production